{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about.html", "destination": "/index.html" },
    { "source": "/contact.html", "destination": "/index.html" },
    { "source": "/services.html", "destination": "/index.html" },
    { "source": "/work.html", "destination": "/index.html" },
    { "source": "/404.html", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ]
}
